@{
    ViewData["Title"] = "Software Deployment - Lab 10";
}

<div class="container py-4">
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm border">
        <div class="container-fluid py-2">
            <h1 class="display-5 fw-bold text-primary">SE Lab 10: Software Deployment</h1>
            <p class="col-md-10 fs-5 text-muted">
                ASP.NET Core 8.0 MVC Application running in a lightweight Linux Container with Docker & CI/CD deployment support.
            </p>
            <div class="d-flex gap-2">
                <span class="badge bg-success p-2 fs-6"><i class="bi bi-check-circle"></i> Docker Container Ready</span>
                <span class="badge bg-info text-dark p-2 fs-6">.NET 8.0 LTS</span>
                <span class="badge bg-dark p-2 fs-6">CI/CD Automated</span>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-primary text-white fw-bold">
                    🎓 Student & Group Information
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item"><strong>Student Name:</strong> Trịnh Đức Long</li>
                        <li class="list-group-item"><strong>Student ID:</strong> 524K0021</li>
                        <li class="list-group-item"><strong>Class:</strong> Software Engineering (FIT - TDTU)</li>
                        <li class="list-group-item"><strong>Instructor:</strong> Mr. Ky-Trung Pham</li>
                        <li class="list-group-item"><strong>GitHub:</strong> <a href="https://github.com/Kuma984" target="_blank">@@Kuma984</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-success text-white fw-bold">
                    🐳 Container Environment Details
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item"><strong>OS Architecture:</strong> @System.Runtime.InteropServices.RuntimeInformation.OSDescription</li>
                        <li class="list-group-item"><strong>Framework:</strong> @System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription</li>
                        <li class="list-group-item"><strong>Process Architecture:</strong> @System.Runtime.InteropServices.RuntimeInformation.ProcessArchitecture</li>
                        <li class="list-group-item"><strong>Host Machine Name:</strong> @Environment.MachineName</li>
                        <li class="list-group-item"><strong>Server Local Time:</strong> @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white fw-bold">
            🚀 Deployment Exercises Completed
        </div>
        <div class="card-body">
            <div class="row text-center g-3">
                <div class="col-md-4">
                    <div class="p-3 border rounded bg-white">
                        <h6 class="fw-bold text-primary">Exercise 1 & 2</h6>
                        <p class="small text-muted mb-0">Multi-stage Dockerfile packaging & local Windows/Linux container execution.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 border rounded bg-white">
                        <h6 class="fw-bold text-success">Exercise 3</h6>
                        <p class="small text-muted mb-0">Docker image export/import (tar), remote Ubuntu deployment & Docker Compose.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 border rounded bg-white">
                        <h6 class="fw-bold text-warning">Exercise 4 & Special</h6>
                        <p class="small text-muted mb-0">GitHub Actions CI/CD automated pipeline build & production environment deployment.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
